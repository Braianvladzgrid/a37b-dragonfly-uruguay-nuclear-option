<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <path>interior.ac</path>

  <animation>
    <!-- Objets opaques -->
    <object-name>interieur</object-name>
    <object-name>inttourvitres</object-name>
    <object-name>inttourverriere</object-name>
    <object-name>planchet</object-name>
    <object-name>cloison</object-name>
    <object-name>verrin1</object-name>
    <object-name>verrin2</object-name>

    <!-- Objets transparents -->
    <object-name>intvitres</object-name>
    <object-name>intverriere</object-name>
    <!-- HDR mode -->
    <object-name>HDRintvitres</object-name>
    <object-name>HDRintverriere</object-name>
  </animation>

  <!-- working for Compositor -->
  <effect>
    <inherits-from>../Effects/Glass/glassrain</inherits-from>
    <object-name>intvitres</object-name>
    <object-name>intverriere</object-name>
  </effect>

  <effect>
    <inherits-from>../Effects/Glass/glass</inherits-from>
    <object-name>HDRintvitres</object-name>
    <object-name>HDRintverriere</object-name>
  </effect>

  <!-- Sélection des vitres en fonction de HDR ou pas -->
  <animation>
    <type>select</type>
    <condition>
      <!-- <property>sim/rendering/hdr/hdr-enabled</property> -->
      <property>sim/multiplay/generic/bool[2]</property>
    </condition>
    <object-name>HDRintvitres</object-name>
    <object-name>HDRintverriere</object-name>
  </animation>

  <animation>
    <type>select</type>
    <condition>
      <!-- <not><property>sim/rendering/hdr/hdr-enabled</property></not> -->
      <not><property>sim/multiplay/generic/bool[2]</property></not>
    </condition>
    <object-name>intvitres</object-name>
    <object-name>intverriere</object-name>
  </animation>

  <model>
    <path>Panel/all-panels.xml</path>
  </model>

  <model>
    <path>../Pilot/all-pilots.xml</path>
  </model>

  <model>
    <path>seats/all-seats.xml</path>
  </model>

  <!-- Canopy -->
  <animation>
    <type>pick</type>
    <object-name>inttourverriere</object-name>
    <object-name>intverriere</object-name>
    <object-name>verrin2</object-name>
    <object-name>HDRintverriere</object-name>
    <visible>true</visible>
    <action>
      <button>0</button>
      <repeatable>false</repeatable>
      <binding>
        <condition>
          <and>
            <property>gear/gear[0]/wow</property>
            <property>gear/gear[1]/wow</property>
            <property>gear/gear[2]/wow</property>
            <less-than>
              <property>gear/gear[0]/rollspeed-ms</property>
              <value>10</value>
            </less-than>
          </and>
        </condition>
        <command>nasal</command>
        <script>doors.crew.toggle();</script>
      </binding>
    </action>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>inttourverriere</object-name>
    <object-name>intverriere</object-name>
    <object-name>verrin2</object-name>
    <object-name>HDRintverriere</object-name>
    <!-- <property>sim/model/door-positions/crew/position-norm</property> -->
    <property>sim/multiplay/generic/float[0]</property>
    <interpolation>
      <entry><ind> 0.0 </ind><dep>  0 </dep></entry>
      <entry><ind> 0.2 </ind><dep>  0 </dep></entry>
      <entry><ind> 1.0 </ind><dep> 40 </dep></entry>
    </interpolation>
    <center>
      <x-m> -0.795 </x-m>
      <y-m>  0.000 </y-m>
      <z-m>  0.213 </z-m>
    </center>
    <axis>
      <x> 0 </x>
      <y> 1 </y>
      <z> 0 </z>
    </axis>
  </animation>

  <animation>
    <type>translate</type>
    <object-name>inttourverriere</object-name>
    <object-name>intverriere</object-name>
    <object-name>verrin2</object-name>
    <object-name>HDRintverriere</object-name>
    <!-- <property>sim/model/door-positions/crew/position-norm</property> -->
    <property>sim/multiplay/generic/float[0]</property>
    <interpolation>
      <entry><ind> 0.0 </ind><dep> 0.00 </dep></entry>
      <entry><ind> 0.2 </ind><dep> 0.05 </dep></entry>
      <entry><ind> 1.0 </ind><dep> 0.05 </dep></entry>
    </interpolation>
    <axis>
      <x> 0 </x>
      <y> 0 </y>
      <z> 1 </z>
    </axis>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>verrin1</object-name>
    <!-- <property>sim/model/door-positions/crew/position-norm</property> -->
    <property>sim/multiplay/generic/float[0]</property>
    <interpolation>
      <entry><ind> 0.0 </ind><dep>  0.00 </dep></entry>
      <entry><ind> 0.2 </ind><dep>  0.40 </dep></entry>
      <entry><ind> 1.0 </ind><dep> 16.00 </dep></entry>
    </interpolation>
    <center>
      <x-m> -1.10828 </x-m>
      <y-m>  0.00000 </y-m>
      <z-m> -0.11367 </z-m>
    </center>
    <axis>
      <x> 0 </x>
      <y> 1 </y>
      <z> 0 </z>
    </axis>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>verrin2</object-name>
    <!-- <property>sim/model/door-positions/crew/position-norm</property> -->
    <property>sim/multiplay/generic/float[0]</property>
    <interpolation>
      <entry><ind> 0.0 </ind><dep>   0.00 </dep></entry>
      <entry><ind> 0.2 </ind><dep>   0.55 </dep></entry>
      <entry><ind> 1.0 </ind><dep> -24.00 </dep></entry>
    </interpolation>
    <center>
      <x-m> -1.15284 </x-m>
      <y-m>  0.00000 </y-m>
      <z-m>  0.26148 </z-m>
    </center>
    <axis>
      <x> 0 </x>
      <y> 1 </y>
      <z> 0 </z>
    </axis>
  </animation>

</PropertyList>
