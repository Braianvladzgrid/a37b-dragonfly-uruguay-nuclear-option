<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <sim               include="views.xml">

    <fuel-fraction>1</fuel-fraction>

    <startup>
      <splash-texture>Aircraft/Cessna-A37-Dragonfly/a37-splash.png</splash-texture>
    </startup>

    <sound>
      <audible>true</audible>
      <path>Aircraft/Cessna-A37-Dragonfly/Sounds/a37-sound.xml</path>
    </sound>

    <model>
      <path>Aircraft/Cessna-A37-Dragonfly/Models/a37.xml</path>
      <livery>
        <file        type="string"/>
        <specular>
          <red       type="float"> 0.03 </red>
          <green     type="float"> 0.03 </green>
          <blue      type="float"> 0.03 </blue>
        </specular>
      </livery>
      <show-copilot  type="bool"/>
      <empty-wings   type="bool"/>
      <show-tank1    type="bool"/>
      <show-tank2    type="bool"/>
      <show-suu1     type="bool"/>
      <show-suu2     type="bool"/>
      <show-cbu241   type="bool"/>
      <show-cbu242   type="bool"/>
      <show-sidew1   type="bool"/>
      <show-sidew2   type="bool"/>
    </model>

    <systems         include="rules.xml"/>

    <instrumentation include="initialisation.xml"/>

    <submodels>
      <serviceable   type="bool">true</serviceable>
      <path>Aircraft/Cessna-A37-Dragonfly/Models/Effects/Weapons/release.xml</path>
    </submodels>

    <multiplay>
      <chat_display>1</chat_display>
      <generic>
        <!-- Immat -->
        <int    n="0"  type="int"/>
        <int    n="1"  type="int"/>
        <int    n="2"  type="int"/>
        <int    n="3"  type="int"/>
        <int    n="4"  type="int"/>
        <int    n="5"  type="int"/>
        <!--  -->
        <int    n="6"  alias="/ai/submodels/submodel[0]/count"/>
        <!-- -->
        <bool   n="0"  alias="/controls/engines/engine[0]/cutoff"/>
        <bool   n="1"  alias="/controls/engines/engine[1]/cutoff"/>
        <bool   n="2"  alias="/sim/rendering/hdr/hdr-enabled"/>
        <bool   n="3"  alias="/gear/gear[0]/wow"/>
        <bool   n="4"  alias="/gear/gear[1]/wow"/>
        <bool   n="5"  alias="/gear/gear[2]/wow"/>
        <!-- -->
        <bool   n="6"  alias="/controls/engines/engine[0]/starter"/>
        <bool   n="7"  alias="/controls/engines/engine[1]/starter"/>
        <!-- -->
        <bool   n="8"  alias="/sim/model/show-copilot"/>
        <!-- -->
        <bool   n="9"  alias="/controls/armament/master-arm"/>
        <!-- -->
        <bool   n="10" alias="/sim/model/empty-wings"/>
        <!-- Lights -->
        <bool   n="11" alias="/controls/lighting/beacon"/>
        <bool   n="12" alias="/sim/model/lights/beacon/state"/>
        <bool   n="13" alias="/controls/lighting/strobe"/>
        <bool   n="14" alias="/sim/model/lights/sbc1/state"/>
        <bool   n="15" alias="/controls/lighting/nav-lights"/>
        <bool   n="16" alias="/controls/lighting/landing-lights"/>
        <!-- -->
        <bool   n="17"  alias="/sim/model/show-tank1"/>
        <bool   n="18"  alias="/sim/model/show-tank2"/>
        <bool   n="19"  alias="/sim/model/show-suu1"/>
        <bool   n="20"  alias="/sim/model/show-suu2"/>
        <bool   n="21"  alias="/sim/model/show-cbu241"/>
        <bool   n="22"  alias="/sim/model/show-cbu242"/>
        <bool   n="23"  alias="/sim/model/show-sidew1"/>
        <bool   n="24"  alias="/sim/model/show-sidew2"/>
        <!-- Doors -->
        <float  n="0"  alias="/sim/model/door-positions/crew/position-norm"/>
        <float  n="1"  alias="/sim/model/door-positions/passenger/position-norm"/>
        <!-- -->
        <float  n="2"  alias="/position/gear-agl-m"/>
        <float  n="3"  alias="/position/altitude-ft"/>
        <!-- Engines -->
        <float  n="4"  alias="/engines/engine[0]/n1"/>
        <float  n="5"  alias="/engines/engine[1]/n1"/>
        <float  n="6"  alias="/controls/engines/engine[0]/throttle"/>
        <float  n="7"  alias="/controls/engines/engine[1]/throttle"/>
        <float  n="8"  alias="/engines/engine[0]/n2"/>
        <float  n="9"  alias="/engines/engine[1]/n2"/>
        <!-- Ground -->
        <float  n="10" alias="/gear/gear[0]/rollspeed-ms"/>
        <float  n="11" alias="/gear/gear[1]/rollspeed-ms"/>
        <float  n="12" alias="/gear/gear[2]/rollspeed-ms"/>
        <float  n="13" alias="/gear/gear[3]/rollspeed-ms"/>
        <!-- -->
        <float  n="14" alias="/gear/gear[0]/caster-angle-deg"/>
        <!-- Compression -->
        <float  n="15" alias="/gear/gear[0]/compression-norm"/>
        <float  n="16" alias="/gear/gear[1]/compression-norm"/>
        <float  n="17" alias="/gear/gear[2]/compression-norm"/>
        <!-- -->
        <float  n="18" alias="/sim/time/sun-angle-rad"/>
        <!-- Engines -->
        <float  n="19"  alias="/engines/engine[0]/afterburner"/>
        <float  n="20"  alias="/engines/engine[1]/afterburner"/>
        <!-- -->
        <string n="1"  alias="/sim/model/livery/texture"/>
        <!-- For Bombable -->
        <int    n="10" type="int" alias="/controls/armament/trigger">0</int>
        <int    n="11" type="int" alias="/controls/armament/triggerE">0</int>
        <int    n="12" type="int" alias="/controls/armament/triggerI">0</int>
        <string n="9"  type="string"/>
      </generic>
    </multiplay>

    <weight              n="0">
      <name              type="string">pylon left ext</name>
      <weight-lb         type="double">0</weight-lb>
      <selected          type="string">none</selected>
      <opt               n="0">
        <name            type="string">none</name>
        <lbs             type="double">0</lbs>
      </opt>
      <opt               n="1">
        <name            type="string">Tank</name>
        <lbs             type="double">760</lbs>
      </opt>
      <opt               n="2">
        <name            type="string">Suu 12</name>
        <lbs             type="double">500</lbs>
      </opt>
      <opt               n="3">
        <name            type="string">CBU 24 A</name>
        <lbs             type="double">830</lbs>
      </opt>
    </weight>

    <weight              n="1">
      <name              type="string">pylon left int</name>
      <weight-lb         type="double">0</weight-lb>
      <selected          type="string">none</selected>
      <opt               n="0">
        <name            type="string">none</name>
        <lbs             type="double">0</lbs>
      </opt>
      <opt               n="1">
        <name            type="string">Tank</name>
        <lbs             type="double">760</lbs>
      </opt>
      <opt               n="2">
        <name            type="string">Suu 12</name>
        <lbs             type="double">500</lbs>
      </opt>
      <opt               n="3">
        <name            type="string">CBU 24 A</name>
        <lbs             type="double">830</lbs>
      </opt>
    </weight>

    <weight              n="2">
      <name              type="string">pylon right int</name>
      <weight-lb         type="double">0</weight-lb>
      <selected          type="string">none</selected>
      <opt               n="0">
        <name            type="string">none</name>
        <lbs             type="double">0</lbs>
      </opt>
      <opt               n="1">
        <name            type="string">Tank</name>
        <lbs             type="double">760</lbs>
      </opt>
      <opt               n="2">
        <name            type="string">Suu 12</name>
        <lbs             type="double">500</lbs>
      </opt>
      <opt               n="3">
        <name            type="string">CBU 24 A</name>
        <lbs             type="double">830</lbs>
      </opt>
    </weight>

    <weight              n="3">
      <name              type="string">pylon right ext</name>
      <weight-lb         type="double">0</weight-lb>
      <selected          type="string">none</selected>
      <opt               n="0">
        <name            type="string">none</name>
        <lbs             type="double">0</lbs>
      </opt>
      <opt               n="1">
        <name            type="string">Tank</name>
        <lbs             type="double">760</lbs>
      </opt>
      <opt               n="2">
        <name            type="string">Suu 12</name>
        <lbs             type="double">500</lbs>
      </opt>
      <opt               n="3">
        <name            type="string">CBU 24 A</name>
        <lbs             type="double">830</lbs>
      </opt>
    </weight>

    <weight              n="4">
      <name              type="string">pylon tipleft ext</name>
      <weight-lb         type="double">0</weight-lb>
      <selected          type="string">none</selected>
      <opt               n="0">
        <name            type="string">none</name>
        <lbs             type="double">0</lbs>
      </opt>
      <opt               n="1">
        <name            type="string">Sidewinder</name>
        <lbs             type="double">155</lbs>
      </opt>
    </weight>

    <weight              n="5">
      <name              type="string">pylon tipleft int</name>
      <weight-lb         type="double">0</weight-lb>
      <selected          type="string">none</selected>
      <opt               n="0">
        <name            type="string">none</name>
        <lbs             type="double">0</lbs>
      </opt>
      <opt               n="1">
        <name            type="string">Sidewinder</name>
        <lbs             type="double">155</lbs>
      </opt>
    </weight>

    <weight              n="6">
      <name              type="string">pylon tipright int</name>
      <weight-lb         type="double">0</weight-lb>
      <selected          type="string">none</selected>
      <opt               n="0">
        <name            type="string">none</name>
        <lbs             type="double">0</lbs>
      </opt>
      <opt               n="1">
        <name            type="string">Sidewinder</name>
        <lbs             type="double">155</lbs>
      </opt>
    </weight>

    <weight              n="7">
      <name              type="string">pylon tipright ext</name>
      <weight-lb         type="double">0</weight-lb>
      <selected          type="string">none</selected>
      <opt               n="0">
        <name            type="string">none</name>
        <lbs             type="double">0</lbs>
      </opt>
      <opt               n="1">
        <name            type="string">Sidewinder</name>
        <lbs             type="double">155</lbs>
      </opt>
    </weight>

    <help            include="help.xml"/>

    <flaps           include="flaps.xml"/>

    <menubar         include="../Dialogs/a37-menu.xml"/>

    <aircraft-data   include="aircraft-data.xml"/>

  </sim>

  <input             include="a37-keyboard.xml"/>

  <controls          include="controls.xml"/>

  <consumables       include="consumables.xml"/>

  <systems           include="systems.xml"/>

  <ai                include="ai.xml"/>

  <instrumentation   include="instrumentation.xml">
    <gsdi>
      <serviceable   type="bool">true</serviceable>
      <enabled       type="bool">true</enabled>
    </gsdi>
  </instrumentation>

  <nasal>
    <doors>
      <file>Aircraft/Cessna-A37-Dragonfly/Nasal/doors.nas</file>
    </doors>
    <a37>
      <file>Aircraft/Cessna-A37-Dragonfly/Nasal/hdr.nas</file>
      <file>Aircraft/Cessna-A37-Dragonfly/Nasal/liveries.nas</file>
      <file>Aircraft/Cessna-A37-Dragonfly/Nasal/light.nas</file>
      <file>Aircraft/Cessna-A37-Dragonfly/Nasal/convert.nas</file>
      <file>Aircraft/Cessna-A37-Dragonfly/Nasal/Electrical.nas</file>
      <file>Aircraft/Cessna-A37-Dragonfly/Nasal/dialogs.nas</file>
      <file>Aircraft/Cessna-A37-Dragonfly/Nasal/mass.nas</file>
      <file>Aircraft/Cessna-A37-Dragonfly/Nasal/hydraulic.nas</file>
    </a37>
    <gmeter>
      <file>Aircraft/Cessna-A37-Dragonfly/Nasal/gmeter.nas</file>
    </gmeter>
    <guns>
      <file>Aircraft/Cessna-A37-Dragonfly/Nasal/weapons.nas</file>
    </guns>
    <engines>
      <file>Aircraft/Cessna-A37-Dragonfly/Nasal/generic-yasim-engine.nas</file>
      <file>Aircraft/Cessna-A37-Dragonfly/Nasal/engines-yasim.nas</file>
    </engines>

    aircraft.data.add(

      "instrumentation/nav[0]/power-btn",
      "instrumentation/nav[0]/audio-btn",
      "instrumentation/nav[0]/frequencies/selected-mhz",
      "instrumentation/nav[0]/frequencies/standby-mhz",
      "instrumentation/nav[0]/to-flag",
      "instrumentation/nav[0]/from-flag",
      "instrumentation/nav[0]/radials/selected-deg",
      "instrumentation/nav[0]/gs-needle-deflection",
      "instrumentation/nav[0]/heading-needle-deflection",
      "instrumentation/nav[0]/in-range",
      "instrumentation/comm[0]/volume",
      "instrumentation/comm[0]/frequencies/selected-mhz",
      "instrumentation/comm[0]/frequencies/standby-mhz",
      "instrumentation/comm[0]/test-btn",

      "instrumentation/nav[1]/power-btn",
      "instrumentation/nav[1]/audio-btn",
      "instrumentation/nav[1]/frequencies/selected-mhz",
      "instrumentation/nav[1]/frequencies/standby-mhz",
      "instrumentation/nav[1]/to-flag",
      "instrumentation/nav[1]/from-flag",
      "instrumentation/nav[1]/radials/selected-deg",
      "instrumentation/nav[1]/gs-needle-deflection",
      "instrumentation/nav[1]/heading-needle-deflection",
      "instrumentation/nav[1]/in-range",
      "instrumentation/comm[1]/volume",
      "instrumentation/comm[1]/frequencies/selected-mhz",
      "instrumentation/comm[1]/frequencies/standby-mhz",
      "instrumentation/comm[1]/test-btn",

    );

  </nasal>

</PropertyList>
